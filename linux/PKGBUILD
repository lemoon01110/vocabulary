# Maintainer: lemoon01110 <228291711+lemoon01110@users.noreply.github.com>
pkgname=gre-vocabulary
pkgver=1.0.0
pkgrel=1
pkgdesc="Offline GRE vocabulary trainer: practice, flashcards and a 2,880-word dictionary"
arch=('any')
url="https://github.com/lemoon01110/vocabulary"
license=('MIT' 'OFL-1.1')
depends=('electron')
makedepends=('python' 'git')
source=("git+https://github.com/lemoon01110/vocabulary.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
  cd vocabulary
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 web/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
